{% macro render(pagination, route, routeParams = {}, queryParams = {}) %}    
    {% set mergedParams = routeParams|merge(queryParams) %}
    <nav aria-label="Page navigation">
        <ul class="pagination">
            {% if (pagination.current_page <= 1) %}
                <li class="page-item disabled">
                    <span class="page-link" aria-hidden="true">&lsaquo;</span>                        
                </li>
            {% else %}
                <li class="page-item">
                    <a href="{{ path(route, mergedParams|merge({ page: pagination.current_page - 1 })) }}" class="page-link">&lsaquo;</a>
                </li>
            {% endif %}
            {% set pages = ((pagination.current_page - 2)..(pagination.current_page + 2))|filter(p => p >= 1 and p <= pagination.total_pages) %}
            {% for page in pages %}
                <li class="page-item {{ page == pagination.current_page ? 'active' : '' }}">
                    <a href="{{ path(route, mergedParams|merge({ page: page })) }}" class="page-link">{{ page }}</a>
                </li>
            {% endfor %}
            {% if (pagination.has_more_pages) %}
                <li class="page-item">
                    <a href="{{ path(route, mergedParams|merge({ page: pagination.current_page + 1 })) }}" class="page-link">&rsaquo;</a>
                </li>
            {% else %}
                <li class="page-item disabled">
                    <span class="page-link" aria-hidden="true">&rsaquo;</span>
                </li>
            {% endif %}
        </ul>
    </nav>
{% endmacro %}